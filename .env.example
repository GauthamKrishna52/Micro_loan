# Copy values into your shell or IDE run configuration. This file is a template only.
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/Micro-loan
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-local-postgres-password
JWT_SECRET=replace-with-a-random-value-at-least-32-characters-long
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
APP_COOKIE_SECURE=false
